{
  "name": "discover-sharm",
  "private": true,
  "description": "Discover Sharm \u2014 static multi-page site",
  "scripts": {
    "build": "npm run build:css && node tools/build.mjs",
    "build:css": "tailwindcss --config tailwind.config.cjs --input tools/tailwind.css --output tailwind.generated.css --minify",
    "dev": "node tools/serve.mjs",
    "dev:live": "node tools/serve.mjs --api https://app.discover-sharm.com",
    "seed": "node tools/make-seed.mjs"
  },
  "devDependencies": {
    "tailwindcss": "3.4.17"
  },
  "engines": {
    "node": ">=18"
  }
}
