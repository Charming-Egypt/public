/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://accounts.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com https://accounts.google.com; font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: blob: https:; connect-src 'self' https://open.er-api.com https://accounts.google.com; frame-src https:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; worker-src 'self'; manifest-src 'self'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(self), payment=(self)
  X-Frame-Options: SAMEORIGIN

/style.css
  Cache-Control: public, max-age=31536000, immutable
/tailwind.css
  Cache-Control: public, max-age=31536000, immutable
/data.js
  Cache-Control: public, max-age=31536000, immutable
/supabase-api.js
  Cache-Control: public, max-age=31536000, immutable
/booking.js
  Cache-Control: public, max-age=31536000, immutable
/frontend.js
  Cache-Control: public, max-age=31536000, immutable
/router.js
  Cache-Control: public, max-age=31536000, immutable
/ds-bridge.js
  Cache-Control: public, max-age=31536000, immutable
/ds-site.js
  Cache-Control: public, max-age=31536000, immutable
/pwa.js
  Cache-Control: public, max-age=31536000, immutable
/site.css
  Cache-Control: public, max-age=31536000, immutable
/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /
/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=3600
/offline.html
  Cache-Control: no-cache
/icons/*
  Cache-Control: public, max-age=2592000
/data/*
  Cache-Control: public, max-age=300
