# Copy to .env for LOCAL builds (npm run build). On Cloudflare Pages set the same names in
# Settings -> Variables and Secrets instead. Never commit .env.
#
# www + app projects need:   DS_SUPABASE_URL, DS_SUPABASE_ANON_KEY, DS_GOOGLE_CLIENT_ID, DS_PAYMENTS_BASE
# admin project needs:       DS_SUPABASE_URL, DS_SUPABASE_ANON_KEY, DS_TRANSLATE_BASE
DS_SUPABASE_URL=
DS_SUPABASE_ANON_KEY=
DS_GOOGLE_CLIENT_ID=
DS_PAYMENTS_BASE=
DS_TRANSLATE_BASE=
